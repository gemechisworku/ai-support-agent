# Copy to .env (never commit .env). Read only via supportagent.common.settings.

# --- Postgres (docker compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=supportagent
POSTGRES_PASSWORD=change-me-local-only
BANK_DB=bank
KB_DB=kb

# --- Mock bank / knowledge base
BANK_AS_OF=                    # optional YYYY-MM-DD override of "today" for demos/tests (e.g. 2026-11-09)
KB_EMBEDDER=llamacpp           # llamacpp | fake  (fake = deterministic hash embedder, used in CI)
KB_MIN_SIMILARITY=0.55         # below this the agent offers a follow-up instead of answering (F6)
CONTACT_RULES_PATH=data/config/contact_rules.yaml   # versioned contact rules + disclosures live in data/config/

# --- Services
BANK_API_URL=http://localhost:8001
GATEWAY_URL=http://localhost:8002/mcp
GATEWAY_SERVICE_TOKEN=change-me-local-only   # scheduler -> gateway /service
GATEWAY_WORKER_TOKEN=change-me-local-only    # agent worker -> gateway /sessions
AUDIT_HASH_SALT=change-me-local-only         # salts args_hash in audit_log
PROMISE_MAX_DAYS=14                          # promise-to-pay window (policy)
HUMAN_AGENT_AVAILABLE=true                   # false -> escalations create callback tickets
SCHEDULER_URL=http://localhost:8003
SCHEDULER_TOKEN=change-me-local-only
CONSOLE_API_URL=http://localhost:8004      # console API (Next.js console backend, T-CON-09)
CONSOLE_API_TOKEN=change-me-local-only      # Next.js server -> console API; never sent to the browser
SCHED_MAX_CONCURRENT=1                       # NFR-CAP: 1-2 on a 16 GB Mac
MAX_CALL_S=600
TRANSCRIPTS_DIR=var/transcripts

# --- Native model servers (Metal; see scripts/models/)
LLM_URL=http://localhost:8090/v1    # llama.cpp llama-server (chat, --jinja tool calls)
EMBED_URL=http://localhost:8082/v1  # llama.cpp llama-server --embedding --pooling mean
LLM_PROVIDER=llamacpp          # llamacpp | anthropic   (F14)
LLM_MODEL=llama-3.1-8b-instruct      # the LLM server's --alias
EMBED_MODEL=nomic-embed-text-v1.5    # the embeddings server's --alias
LLM_GGUF=models/llm/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf  # point at an existing GGUF to reuse it
EMBED_GGUF=models/embed/nomic-embed-text-v1.5.Q8_0.gguf
STT_URL=http://localhost:8178  # whisper.cpp server
WHISPER_MODEL=small.en         # or large-v3-turbo for accuracy (~1.6 GB)
SILENCE_REPROMPT_S=6
SILENCE_END_S=15
TTS_URL=http://localhost:8880  # Kokoro-FastAPI
TTS_VOICE=af_heart
ANTHROPIC_API_KEY=             # only when LLM_PROVIDER=anthropic (synthetic data only)

# --- LiveKit / telephony
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
SIP_OUTBOUND_TRUNK_ID=
SIP_INBOUND_TRUNK_ID=
SUPPORT_EXTENSION=100
HUMAN_AGENT_EXTENSION=200
TEL_ADVERTISED_IP=             # your Mac's LAN IP (pinned for RTP; see infra/telephony/README.md)
ASTERISK_HOST=localhost
TRANSFER_TIMEOUT_S=25

# --- Observability (optional)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Persona
BANK_NAME=Meridian Bank
AGENT_NAME=Ava
